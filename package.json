{
  "name": "jarvis",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w apps/web",
    "lint": "npm run lint -w apps/web"
  },
  "version": "1.0.0"
}
