ENVIRONMENT=development
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
POSTGRES_PASSWORD=jarvis
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3010
COOKIE_SECURE=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_TEMPERATURE=0.6
OLLAMA_STREAM=true
VOICE_STT_URL=
VOICE_TTS_URL=
# Local option: espeak (requires espeak-ng); external VOICE_TTS_URL takes precedence.
VOICE_TTS_ENGINE=disabled
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.10:8010/api/v1

OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=15m

DESKTOP_VOICE_COMMANDS=false

# Mahalliy ovoz profili uchun true va VOICE_TTS_ENGINE=espeak sozlang.
VOICE_LOCAL_ONLY=false
VOICE_STT_MODEL=small
VOICE_STT_DEVICE=auto
VOICE_TTS_SPEED=155

VOICE_ALLOW_EDGE_TTS=false

TELEGRAM_BOT_TOKEN=
